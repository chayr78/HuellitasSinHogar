# Copia este archivo como .env y pon tus valores reales. El .env no se sube a git.
# Todos los valores de aquí son de ejemplo.

# Base de datos: URL del Session pooler de Supabase (Connect > Session pooler)
DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres
DB_USER=postgres.tu_ref_de_proyecto
DB_PASSWORD=cambia_esta_contrasena

# Clave para firmar los JWT (al menos 32 caracteres)
JWT_SECRET=cambia_esta_clave_por_una_de_32_o_mas_caracteres

# Administrador inicial (se crea solo si aún no existe ninguno)
ADMIN_CORREO=admin@ejemplo.com
ADMIN_PASSWORD=cambia_esta_contrasena

# Clave secret de Supabase para subir fotos a Storage
SUPABASE_SERVICE_KEY=sb_secret_ejemplo

# Frontend: orígenes permitidos (separados por comas) y URL para los enlaces de correo
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
